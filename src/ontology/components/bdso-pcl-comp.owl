        <custom:node_metadata>{&quot;cell_set_preferred_alias&quot;: &quot;Lamp5 Egln3_2&quot;, &quot;original_label&quot;: &quot;Lamp5 Egln3_2&quot;, &quot;cell_set_label&quot;: &quot;RNAseq 003&quot;, &quot;cell_set_accession&quot;: &quot;CS202002013_3&quot;, &quot;cell_set_aligned_alias&quot;: &quot;&quot;, &quot;cell_set_additional_aliases&quot;: &quot;Canopy cell&quot;, &quot;cell_set_alias_assignee&quot;: &quot;Zizhen Yao|Federico Scala|Zizhen Yao&quot;, &quot;cell_set_alias_citation&quot;: &quot;PMID:34616066|PMID:33184512|PMID:34616066&quot;, &quot;cell_set_structure&quot;: &quot;primary motor cortex&quot;, &quot;cell_set_ontology_tag&quot;: &quot;UBERON:0001384&quot;, &quot;species&quot;: &quot;Mouse&quot;, &quot;modality&quot;: &quot;RNAseq&quot;, &quot;taxonomy_id&quot;: &quot;CCN202002013&quot;, &quot;taxonomy_description&quot;: &quot;Mouse MOp BICCN taxonomy using multiple RNA-Seq datasets &quot;, &quot;child_cell_set_accessions&quot;: &quot;&quot;, &quot;cell_type_card&quot;: &quot;Cell Type&quot;, &quot;cell_set_color&quot;: &quot;#DD8091&quot;}</custom:node_metadata>
        <custom:original_label>Lamp5 Egln3_2</custom:original_label>
