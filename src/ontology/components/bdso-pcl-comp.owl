        <obo:PCL_0010058>PCOLCE2 (Hsap)</obo:PCL_0010058>
        <obo:PCL_0010058>SLC15A5 (Hsap)</obo:PCL_0010058>
        <obo:PCL_0010058>SLITRK6 (Hsap)</obo:PCL_0010058>
        <oboInOwl:hasExactSynonym>Exc L6 FEZF2 OR2T8</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>PCOLCE2 (Hsap), IGFBP3 (Hsap), SLC15A5 (Hsap), SLITRK6 (Hsap) expressing glutamatergic neuron of middle temporal gyrus (Homo sapiens)</oboInOwl:hasExactSynonym>
        <rdfs:label>Exc L6 FEZF2 OR2T8 middle temporal gyrus glutamatergic neuron (Hsap)</rdfs:label>
