    <!-- http://purl.obolibrary.org/obo/PCL_0012453 -->

    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/PCL_0012453">
        <rdf:type rdf:resource="http://schema.org/Dataset"/>
        <obo:IAO_0000028>Mouse MOp sc10x v2</obo:IAO_0000028>
        <obo:PCL_0010060 rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">122641</obo:PCL_0010060>
        <schema:archivedAt>https://data.nemoarchive.org/biccn/grant/u19_zeng/zeng/transcriptome/scell/10x_v2/mouse/processed/analysis/10X_cells_v2_AIBS/</schema:archivedAt>
        <schema:assesses>mouse</schema:assesses>
        <schema:discussionUrl>https://nemoanalytics.org/index.html?layout_id=1b58cf00&amp;gene_symbol=gad2&amp;gene_symbol_exact_match=1</schema:discussionUrl>
        <schema:headline>CCN202002013</schema:headline>
        <schema:includedInDataCatalog rdf:resource="http://purl.obolibrary.org/obo/pcl/CCN202002013"/>
        <schema:position>MOp</schema:position>
        <rdfs:comment>10x 3&apos; v2 is the second version of the 10x sequencing technology that sequences from the 3&apos; end of nucleic acid molecules. In the 3&apos; assay, the polyd(T) sequence is part of the gel bead oligo (which also contains the 10x barcode, UMI, and partial Illuma Read 1 sequence), with the template switch oligo (TSO) supplied in the RT Primer.</rdfs:comment>
        <rdfs:label>Mouse MOp (CCN202002013) single cell 10x Chromium v2</rdfs:label>
        <skos:prefLabel>10x Chromium v2</skos:prefLabel>
    </owl:NamedIndividual>
    


