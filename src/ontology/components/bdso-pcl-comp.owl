        <obo:PCL_0010058>LYPD6 (Hsap)</obo:PCL_0010058>
        <obo:PCL_0010058>PAWR (Hsap)</obo:PCL_0010058>
        <oboInOwl:hasExactSynonym>Inh L5-6 SST MIR548F2</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>LYPD6 (Hsap), GPC5 (Hsap), PAWR (Hsap) expressing GABAergic interneuron of middle temporal gyrus (Homo sapiens)</oboInOwl:hasExactSynonym>
        <rdfs:label>Inh L5-6 SST MIR548F2 middle temporal gyrus GABAergic interneuron (Hsap)</rdfs:label>
