    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/pcl/CS201912132_108">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/PCL_0010001"/>
        <obo:RO_0015003 rdf:resource="http://purl.obolibrary.org/obo/pcl/CS201912132_207"/>
