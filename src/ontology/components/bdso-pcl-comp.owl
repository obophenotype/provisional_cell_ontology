    <owl:NamedIndividual rdf:about="http://purl.obolibrary.org/obo/pcl/CS202002013_232">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/PCL_0010001"/>
        <rdf:type>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0015002"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/PCL_0011232"/>
