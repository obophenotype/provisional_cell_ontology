        <obo:PCL_0010058>CPED1 (Hsap)</obo:PCL_0010058>
        <obo:PCL_0010058>SEMA3C (Hsap)</obo:PCL_0010058>
        <oboInOwl:hasExactSynonym>Inh L5-6 LHX6 GLP1R</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>SEMA3C (Hsap), BCHE (Hsap), CPED1 (Hsap) expressing GABAergic interneuron of middle temporal gyrus (Homo sapiens)</oboInOwl:hasExactSynonym>
        <rdfs:label>Inh L5-6 LHX6 GLP1R middle temporal gyrus GABAergic interneuron (Hsap)</rdfs:label>
