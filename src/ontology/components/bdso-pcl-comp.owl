        <oboInOwl:hasExactSynonym>ERG (Hsap), NPNT (Hsap), NR4A2 (Hsap) expressing glutamatergic neuron of middle temporal gyrus (Homo sapiens)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Exc L5-6 FEZF2 IL15</oboInOwl:hasExactSynonym>
        <rdfs:label>Exc L5-6 FEZF2 IL15 middle temporal gyrus glutamatergic neuron (Hsap)</rdfs:label>
