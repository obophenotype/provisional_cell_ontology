        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A L2/3 pvalb-like sst GABAergic cortical interneuron (Mus musculus) that has Martinotti morphology.</owl:annotatedTarget>
        <oboInOwl:hasDbXref>PMID:33184512</oboInOwl:hasDbXref>
    </owl:Axiom>
    


