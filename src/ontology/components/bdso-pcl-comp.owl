        <obo:PCL_0010058>FREM1 (Hsap)</obo:PCL_0010058>
        <obo:PCL_0010058>MYH11 (Hsap)</obo:PCL_0010058>
        <oboInOwl:hasExactSynonym>FREM1 (Hsap), MYH11 (Hsap), ADAMTS20 (Hsap) expressing GABAergic interneuron of primary motor cortex (Homo sapiens)</oboInOwl:hasExactSynonym>
        <oboInOwl:hasExactSynonym>Inh L1 LAMP5 RAB11FIP1</oboInOwl:hasExactSynonym>
        <rdfs:label>Inh L1 LAMP5 RAB11FIP1 primary motor cortex GABAergic interneuron (Hsap)</rdfs:label>
