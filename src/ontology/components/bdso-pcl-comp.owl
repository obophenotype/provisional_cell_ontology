            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A L2/3 pvalb-like sst GABAergic cortical interneuron (Mus musculus) that has Martinotti morphology.</obo:IAO_0000115>
        <dc:contributor rdf:resource="http://orcid.org/0000-0001-7258-9596"/>
        <oboInOwl:hasExactSynonym>Martinotti L2/3 PV-like SST (Mus)</oboInOwl:hasExactSynonym>
        <rdfs:label>Martinotti morphology L2/3 pvalb-like sst GABAergic cortical interneuron (Mus musculus)</rdfs:label>
    </owl:Class>
    <owl:Axiom>
