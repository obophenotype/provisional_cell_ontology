        <oboInOwl:hasExactSynonym>OLFML2B (Hsap), SNTB1 (Hsap) expressing glutamatergic neuron of middle temporal gyrus (Homo sapiens)</oboInOwl:hasExactSynonym>
        <rdfs:label>Exc L5-6 THEMIS CRABP1 middle temporal gyrus glutamatergic neuron (Hsap)</rdfs:label>
    </owl:Class>
